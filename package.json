{
  "name": "cslifeline",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "CS Lifeline — Computer Science learning analytics and early-warning system",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:ml": "cd ml && python -m pytest -q tests",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cslifeline \"node --test tests/rules/\"",
    "test:all": "npm test && npm run test:ml && npm run test:e2e",
    "data:synthetic": "node scripts/synthetic/generate.mjs",
    "ml:train": "cd ml && python -m cslifeline_ml train",
    "data:demo": "node scripts/attach-ml-to-demo.mjs && node scripts/make-feature-fixture.mjs",
    "build:functions": "node scripts/sync-functions-shared.mjs",
    "provision-admin": "node scripts/provision-admin.mjs",
    "migrate:v3": "node scripts/migrate-v3.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^15.35.0"
  },
  "engines": { "node": ">=20" }
}
