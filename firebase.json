{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [ { "source": "functions", "codebase": "cslifeline", "predeploy": ["node scripts/sync-functions-shared.mjs"] } ],
  "hosting": {
    "public": "public",
    "cleanUrls": false,
    "headers": [ { "source": "**", "headers": [ { "key": "X-Frame-Options", "value": "DENY" }, { "key": "X-Content-Type-Options", "value": "nosniff" } ] } ]
  },
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8080 }, "functions": { "port": 5001 }, "ui": { "enabled": true } }
}
